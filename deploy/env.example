# invest-ai-llm non-secret settings. Copy to deploy/.env (git-ignored) and edit.
# NEVER put passwords, keys or tokens here: secrets are Compose file secrets
# (see deploy/secrets/README.md).

# Image tag loaded with `docker load` (see deploy/runbook.md).
APP_VERSION=dev

# Caddy site addresses (comma-separated) and TLS mode.
APP_SITE_ADDRESSES=https://nbfcuatyolomlapp01:8043
# "internal" = Caddy's local CA. For a provided certificate, put cert.pem/key.pem in
# APP_TLS_DIR and set: APP_TLS=/etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
APP_TLS=internal
APP_TLS_DIR=/etc/foundry/tls

APP_LOG_LEVEL=INFO

# Host paths. Persistent disk only; never /mnt (ephemeral Azure temp disk).
APP_DATA_DIR=/data
APP_SECRETS_DIR=/etc/foundry/secrets
APP_KEK_FILE=/etc/foundry/kek
