#!/usr/sbin/nft -f
# OPTIONAL host egress default-deny (defence in depth; Story 1.3, ADR-034).
# Outbound internet is already blocked by the Azure NSG. This adds a host-level net.
#
# Review before use: interface names (eth0), the Azure platform addresses and the
# backup target. Install as /etc/nftables.d/invest-ai-egress.nft (or include it from
# /etc/nftables.conf) and load with `nft -f`. It uses its own table and does not
# touch Docker's rules; keep Docker's iptables management enabled.
#
# Test from a second SSH session first; output policy drop can lock you out of
# anything that is not an established connection.

table inet invest_ai_egress {
	set azure_platform {
		type ipv4_addr
		# Azure DNS/DHCP/health probes (168.63.129.16) and instance metadata (IMDS).
		elements = { 168.63.129.16, 169.254.169.254 }
	}

	# set backup_target {
	#	type ipv4_addr
	#	elements = { 10.0.0.50 }     # off-host backup target (ADR-035), when provided
	# }

	# Traffic originated by the host itself.
	chain output {
		type filter hook output priority filter; policy drop;

		oifname "lo" accept
		ct state established,related accept
		ip daddr @azure_platform accept
		# Host -> containers (healthchecks, docker exec traffic stays local).
		oifname { "docker0", "br-*" } accept
		# ip daddr @backup_target tcp dport 22 accept

		counter log prefix "invest-ai egress drop: " level warn drop
	}

	# Traffic routed through the host (containers).
	chain forward {
		type filter hook forward priority filter - 10; policy accept;

		ct state established,related accept
		# Inbound published-port traffic (DNAT to caddy:8043) is allowed.
		ct status dnat accept
		# Containers may not originate traffic towards the outside interface.
		oifname "eth0" counter log prefix "invest-ai container egress drop: " level warn drop
	}
}
