# vllm-chat launch configuration (Story 1.4; ADR-009, ADR-029, ADR-031).
# Changing the model or limits is configuration only: edit this file, then
#   docker compose -f deploy/compose.yml up -d vllm-chat
#
# VLLM_MODEL is a directory under /data/models (mounted read-only at /models), installed
# by deploy/models/stage-models.sh.
# Fallback: VLLM_MODEL=/models/Qwen3-8B-AWQ (same flags).
VLLM_MODEL=/models/Qwen3-14B-AWQ

# GPU split on the A10-24Q: chat 0.78 + guard 0.12 (0.10 headroom for CUDA contexts).
# --scheduling-policy priority lets summary jobs run below interactive chat (ADR-029).
VLLM_ARGS=--served-model-name chat --gpu-memory-utilization 0.78 --max-model-len 16384 --kv-cache-dtype fp8 --enable-prefix-caching --max-num-seqs 16 --enable-auto-tool-choice --tool-call-parser hermes --scheduling-policy priority --host 0.0.0.0 --port 8000

# Offline and no telemetry (ADR-034).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
VLLM_DO_NOT_TRACK=1
DO_NOT_TRACK=1
