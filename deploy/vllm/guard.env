# vllm-guard launch configuration (Story 1.4; ADR-009).
# Qwen3Guard-Gen classifies prompts and responses (Safe / Unsafe / Controversial).
VLLM_MODEL=/models/Qwen3Guard-Gen-0.6B

# --max-num-seqs bounds the CUDA-graph and KV footprint inside the 0.12 share.
VLLM_ARGS=--served-model-name guard --gpu-memory-utilization 0.12 --max-model-len 4096 --max-num-seqs 16 --host 0.0.0.0 --port 8000

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
VLLM_DO_NOT_TRACK=1
DO_NOT_TRACK=1
